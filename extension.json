{
	"name": "NearMe",
	"version": "0.3.0",
	"author": [ "Tom O'Neill", "Saintapedia contributors" ],
	"url": "https://www.mediawiki.org/wiki/Extension:NearMe",
	"descriptionmsg": "nearme-desc",
	"license-name": "MIT",
	"type": "specialpage",
	"requires": {
		"MediaWiki": ">= 1.39.0",
		"extensions": {
			"Cargo": ">= 3.0.0"
		}
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\NearMe\\": "includes/"
	},
	"MessagesDirs": {
		"NearMe": [ "i18n" ]
	},
	"ExtensionMessagesFiles": {
		"NearMeAliases": "NearMe.alias.php"
	},
	"SpecialPages": {
		"Nearby": "MediaWiki\\Extension\\NearMe\\SpecialNearby"
	},
	"APIModules": {
		"cargonearby": "MediaWiki\\Extension\\NearMe\\ApiCargoNearby",
		"cargonearbysearch": "MediaWiki\\Extension\\NearMe\\ApiCargoNearbySearch"
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteExtPath": "NearMe"
	},
	"ResourceModules": {
		"ext.NearMe.styles": {
			"styles": [ "modules/ext.NearMe.css" ]
		},
		"ext.NearMe": {
			"scripts": [
				"modules/location-provider.js",
				"modules/nearby-api.js",
				"modules/ext.NearMe.js"
			],
			"dependencies": [
				"jquery",
				"mediawiki.api",
				"mediawiki.util",
				"mediawiki.router",
				"mediawiki.jqueryMsg"
			],
			"messages": [
				"nearme-title",
				"nearme-info-heading",
				"nearme-info-description",
				"nearme-show-button",
				"nearme-show-button-table",
				"nearme-filter-all",
				"nearme-filter-label",
				"nearme-search-label",
				"nearme-search-placeholder",
				"nearme-search-no-matches",
				"nearme-search-result-count",
				"nearme-name-search-label",
				"nearme-name-search-hint",
				"nearme-name-search-placeholder",
				"nearme-name-search-button",
				"nearme-name-search-nearby",
				"nearme-name-search-open-page",
				"nearme-name-search-no-matches",
				"nearme-name-search-too-short",
				"nearme-name-searching",
				"nearme-privacy-hint",
				"nearme-try-without-gps",
				"nearme-distance-km",
				"nearme-distance-m",
				"nearme-requirements",
				"nearme-requirements-guidance",
				"nearme-error",
				"nearme-error-guidance",
				"nearme-noresults",
				"nearme-noresults-guidance",
				"nearme-location-unavailable",
				"nearme-permission-denied",
				"nearme-locating",
				"nearme-loading",
				"nearme-map-label",
				"nearme-map-toggle"
			],
			"config": [
				"NearMeDefaultRadius",
				"NearMeDefaultLimit",
				"NearMeTables"
			]
		},
		"ext.NearMe.maps": {
			"scripts": [
				"modules/nearby-map.js"
			],
			"dependencies": [
				"ext.maps.leaflet.library",
				"ext.maps.leaflet.markercluster"
			],
			"messages": [
				"nearme-map-you-are-here"
			]
		}
	},
	"config": {
		"NearMeDefaultRadius": {
			"value": 10000,
			"description": "Default search radius in meters (NearbyPages uses 10 km)."
		},
		"NearMeMaxRadius": {
			"value": 50000,
			"description": "Maximum allowed search radius in meters."
		},
		"NearMeDefaultLimit": {
			"value": 50,
			"description": "Default maximum number of results returned."
		},
		"NearMeMaxLimit": {
			"value": 100,
			"description": "Maximum allowed result count per request."
		},
		"NearMeTables": {
			"value": [
				{
					"table": "Parishes",
					"coordField": "ParishLocation",
					"label": "Parishes"
				}
			],
			"description": "Fallback when MediaWiki:NearMe-config is absent. Each entry requires table, coordField, and label (friendly table name). Optional: labelField (row display; defaults to page title), default (pre-selected tab), searchFields (Cargo columns OR-matched by hero name search; defaults to _pageName + labelField), displayFields (extra Cargo columns shown under each name match)."
		},
		"NearMeExamples": {
			"value": [
				{
					"label": "Philadelphia, PA",
					"lat": 39.9526,
					"lon": -75.1652
				}
			],
			"description": "Default 'Try without GPS' location links on Special:Nearby. Overridden by a non-empty examples array in MediaWiki:NearMe-config. Set to [] to hide examples when no wiki list is set."
		},
		"NearMeConfigPage": {
			"value": "NearMe-config",
			"description": "MediaWiki page (JSON) listing Cargo sources, defaults, and labels. Takes precedence over $wgNearMeTables when present."
		},
		"NearMeIntroPage": {
			"value": "",
			"description": "Optional MediaWiki page name (e.g. NearMe-intro) with wikitext shown above the Nearby app. Leave empty to show no intro."
		}
	},
	"manifest_version": 2
}